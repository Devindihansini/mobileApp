<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LMSApp"
        tools:targetApi="31">

        <!-- First Page (Get Started) -->
        <activity
            android:name=".firstActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Second Page -->
        <activity
            android:name=".SecondActivity"
            android:exported="true" /> <!-- Third Page -->
        <activity
            android:name=".thirdActivity"
            android:exported="true" /> <!-- Fourth Page -->
        <activity
            android:name=".quizActivity"
            android:exported="true" /> <!-- Fifth Page -->
        <activity
            android:name=".subjectsActivity"
            android:exported="true" /> <!-- Sixth Page -->
        <activity
            android:name=".teachersActivity"
            android:exported="true" /> <!-- Seventh Page -->
        <activity
            android:name=".profileActivity"
            android:exported="false" />
    </application>

</manifest>